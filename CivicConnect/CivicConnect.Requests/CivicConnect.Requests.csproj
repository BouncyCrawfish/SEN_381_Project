<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CivicConnect.Requests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CivicConnect.Common\CivicConnect.Common.csproj" />
    <!-- Public contracts only (ISessionContext, IAccessControl, IUserService, Permission, UserDto). -->
    <ProjectReference Include="..\CivicConnect.Auth\CivicConnect.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test assembly is named CivicConnect.Tests, so that is the name that must be listed. -->
    <InternalsVisibleTo Include="CivicConnect.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same versions as CivicConnect.Auth so the solution resolves one version of each. -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
