<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CivicConnect.App</RootNamespace>
    <!-- Lets 'dotnet user-secrets' store the DB password outside the repo. -->
    <UserSecretsId>ba9bc275-cf85-415c-b7fe-7bdb45d97893</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CivicConnect.Common\CivicConnect.Common.csproj" />
    <ProjectReference Include="..\CivicConnect.Auth\CivicConnect.Auth.csproj" />
	<ProjectReference Include="..\CivicConnect.Notifications\CivicConnect.Notifications.csproj" />
	<ProjectReference Include="..\CivicConnect.AuditLog\CivicConnect.AuditLog.csproj" />
	<ProjectReference Include="..\CivicConnect.Requests\CivicConnect.Requests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 'Update' (not 'Include') so a fresh clone WITHOUT the gitignored appsettings.json still builds. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

</Project>
